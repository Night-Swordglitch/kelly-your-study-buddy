/* =========================================================
   KELLY APP — DARK DASHBOARD + SIDEBAR + NOTES
   ========================================================= */

.kelly-app {
  min-height: 100vh;
  background: #0a0a0f;
  color: #f8f7fb;
  display: flex;
}

/* ============================================================
   KELLY SIDEBAR
   Reference: Appmedo /listen
   Width: 208px
   ============================================================ */

.kelly-sidebar {
  width: 208px;
  min-width: 208px;
  height: 100vh;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  box-sizing: border-box;
}

/* ── Header ─────────────────────────────────────────────────── */

.kelly-sidebar-header {
  width: 100%;
  height: 76px;
  flex: 0 0 76px;

  display: flex;
  align-items: center;

  padding: 24px 20px 16px;

  box-sizing: border-box;
}

.kelly-sidebar-logo {
  width: 100%;
  height: 36px;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 0;
  margin: 0;

  border: 0;
  background: transparent;

  cursor: pointer;

  color: inherit;
  font-family: inherit;

  text-align: left;
}

.kelly-sidebar-avatar {
  width: 36px;
  height: 36px;

  flex: 0 0 36px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.kelly-sidebar-avatar > * {
  width: 36px;
  height: 36px;
}

.kelly-sidebar-word {
  font-family: var(--font-display, "Sora", "Inter", system-ui, sans-serif);
  font-size: 16px;
  font-weight: 700;
  line-height: 1;

  letter-spacing: -0.02em;
}

/* ── Level / XP ─────────────────────────────────────────────── */

.kelly-sidebar-level {
  width: 100%;
  height: 42px;
  flex: 0 0 42px;

  padding: 0 20px 16px;

  box-sizing: border-box;
}

.kelly-sidebar-level-row {
  width: 167.2px;
  height: 16px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 6px;
}

.kelly-sidebar-level-row span {
  font-family: var(--font-body, "Inter", system-ui, sans-serif);
  font-size: 12px;
  line-height: 16px;
}

.kelly-sidebar-level-name {
  font-weight: 700;
}

.kelly-sidebar-level-xp {
  font-weight: 400;
}

.kelly-sidebar-xp-track {
  width: 167.2px;
  height: 4px;

  border-radius: 999px;
  overflow: hidden;
}

.kelly-sidebar-xp-fill {
  width: 36%;
  height: 100%;

  border-radius: 999px;

  transition: width 500ms ease;
}

/* ── Navigation ─────────────────────────────────────────────── */

.kelly-sidebar-nav {
  flex: 1 1 auto;
  min-height: 0;

  width: 100%;

  display: flex;
  flex-direction: column;

  padding: 0 12px 8px;

  box-sizing: border-box;

  gap: 2px;

  overflow-y: auto;
  overflow-x: hidden;
}

.kelly-sidebar-link {
  width: 100%;
  min-height: 40px;

  flex: 0 0 auto;

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 16px;

  box-sizing: border-box;

  border: 0;
  border-radius: 10px;

  background: transparent;

  color: #878793;

  font-family: var(--font-body, "Inter", system-ui, sans-serif);
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;

  text-align: left;

  cursor: pointer;

  transition:
    background-color 160ms ease,
    color 160ms ease;
}

.kelly-sidebar-link:hover:not(:disabled) {
  background: rgba(139, 92, 246, 0.10);
}

.kelly-sidebar-link.active {
  background: rgba(139, 92, 246, 0.18);
  color: #ffffff;
}

.kelly-sidebar-link:disabled {
  cursor: default;
  opacity: 1;
}

.kelly-sidebar-icon {
  width: 16px;
  height: 16px;

  flex: 0 0 16px;
}

.kelly-sidebar-link > span:last-child {
  min-width: 0;
}

/* Listen & Transcribe naturally wraps to two lines,
   giving the reference 60px height. */
.kelly-sidebar-link:nth-child(3) {
  min-height: 60px;
}

/* ── Bottom / Settings ─────────────────────────────────────── */

.kelly-sidebar-bottom {
  width: 100%;
  height: 68.8px;
  flex: 0 0 68.8px;

  padding: 8px 12px 20px;

  box-sizing: border-box;
}

.kelly-sidebar-bottom .kelly-sidebar-link {
  min-height: 40px;
}

/* ---------- MAIN CONTENT ---------- */

.kelly-main {
  flex: 1;
  min-width: 0;
  min-height: 100vh;
  background: #0a0a0f;
}

/* =========================================================
   DASHBOARD (kelly-medo-*)
   ========================================================= */

.kelly-medo-dashboard {
  position: relative;
  width: 100%;
  min-height: 100vh;
  padding: 24px 28px 40px;
  box-sizing: border-box;
}

.kelly-medo-ambient {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 82% 0%, rgba(139, 92, 246, 0.07), transparent 30%);
  pointer-events: none;
  z-index: 0;
}

.kelly-medo-welcome {
  position: relative;
  z-index: 1;
  margin-bottom: 16px;
}

.kelly-medo-avatar {
  margin-bottom: 10px;
}

.kelly-medo-eyebrow {
  color: #767681;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.13em;
  margin: 0 0 4px;
}

.kelly-medo-welcome h1 {
  margin: 0;
  color: #f8f7fb;
  font-size: 28px;
  font-weight: 750;
  letter-spacing: -0.03em;
}

.kelly-medo-welcome h1 span {
  color: #a78bfa;
}

.kelly-medo-subtitle {
  margin: 6px 0 0;
  color: #8d8d99;
  font-size: 14px;
  max-width: 60ch;
}

/* ---------- Shared card ---------- */

.kelly-medo-card {
  position: relative;
  z-index: 1;
  background: #101016;
  border: 1px solid #24242e;
  border-radius: 14px;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.018);
  padding: 20px;
}

.kelly-medo-label {
  color: #767681;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.13em;
}

.kelly-medo-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.kelly-medo-card-top h2 {
  margin: 4px 0 0;
  color: #f5f4fa;
  font-size: 18px;
  font-weight: 700;
}

.kelly-medo-icon {
  width: 38px;
  height: 38px;
  min-width: 38px;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kelly-medo-icon svg {
  width: 18px;
  height: 18px;
}

.kelly-medo-icon.blue {
  background: rgba(59, 130, 246, 0.14);
  color: #7bb3ff;
}

.kelly-medo-icon.pink {
  background: rgba(236, 72, 153, 0.14);
  color: #f97fc0;
}

.kelly-medo-card-description {
  margin: 14px 0 0;
  color: #b9b7c4;
  font-size: 13px;
  line-height: 1.6;
}

/* ---------- Primary grid ---------- */

.kelly-medo-primary-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 12px;
}

.kelly-medo-progress-header {
  display: flex;
  justify-content: space-between;
  margin-top: 18px;
  font-size: 12px;
  color: #767681;
}

.kelly-medo-progress-header strong {
  color: #a78bfa;
}

.kelly-medo-progress {
  height: 7px;
  border-radius: 99px;
  background: #1d1d26;
  overflow: hidden;
  margin-top: 8px;
}

.kelly-medo-progress > div {
  height: 100%;
  background: linear-gradient(90deg, #7c3aed, #a78bfa);
  border-radius: inherit;
  transition: width 0.4s ease;
}

.kelly-medo-study-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18px;
}

.kelly-medo-study-footer > span {
  font-size: 12px;
  color: #6e6e79;
}

.kelly-medo-blue-button {
  background: #7c3aed !important;
  color: #fff !important;
  border-radius: 9px !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.kelly-medo-blue-button svg {
  width: 14px;
  height: 14px;
}

/* Progress card */

.kelly-medo-progress-card .kelly-medo-card-top h2 {
  font-size: 26px;
  font-weight: 750;
  color: #f6f4fa;
}

.kelly-medo-big-progress {
  height: 10px;
  border-radius: 99px;
  background: #1d1d26;
  overflow: hidden;
  margin-top: 18px;
}

.kelly-medo-big-progress > div {
  height: 100%;
  background: linear-gradient(90deg, #7c3aed, #a78bfa);
  border-radius: inherit;
}

.kelly-medo-stat-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 18px;
}

.kelly-medo-stat-row strong {
  display: block;
  color: #f6f4fa;
  font-size: 20px;
  font-weight: 750;
}

.kelly-medo-stat-row span {
  color: #777782;
  font-size: 11px;
}

.kelly-medo-small-message {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
  padding: 10px 12px;
  background: rgba(139, 92, 246, 0.08);
  border-radius: 10px;
  color: #c5baff;
  font-size: 11px;
  line-height: 1.5;
}

.kelly-medo-small-message svg {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}

/* ---------- Upcoming card ---------- */

.kelly-medo-upcoming-card {
  margin-bottom: 12px;
}

.kelly-medo-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}

.kelly-medo-section-heading h2 {
  margin: 4px 0 0;
  color: #f5f4fa;
  font-size: 17px;
  font-weight: 700;
}

.kelly-medo-add-button {
  border-color: rgba(139, 92, 246, 0.25) !important;
  color: #a78bfa !important;
  background: transparent !important;
  font-size: 12px !important;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.kelly-medo-add-button svg {
  width: 14px;
  height: 14px;
}

.kelly-medo-deadline-form {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr auto;
  gap: 8px;
  margin-bottom: 16px;
}

.kelly-medo-deadline-list {
  display: flex;
  flex-direction: column;
}

.kelly-medo-deadline {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 4px;
  border: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.kelly-medo-deadline:first-child {
  border-top: 0;
}

.kelly-medo-deadline-icon {
  width: 30px;
  height: 30px;
  min-width: 30px;
  border-radius: 9px;
  background: rgba(139, 92, 246, 0.1);
  color: #a78bfa;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kelly-medo-deadline-icon svg {
  width: 14px;
  height: 14px;
}

.kelly-medo-deadline-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.kelly-medo-deadline-info strong {
  color: #f3f2f7;
  font-size: 13px;
  font-weight: 650;
}

.kelly-medo-deadline-info span {
  margin-top: 3px;
  color: #71717c;
  font-size: 11px;
}

.kelly-medo-check {
  margin-left: auto;
  color: #42d58a;
  display: flex;
}

.kelly-medo-check svg {
  width: 16px;
  height: 16px;
}

.kelly-medo-empty {
  text-align: center;
  padding: 30px 10px;
}

.kelly-medo-empty-icon {
  width: 34px;
  height: 34px;
  margin: 0 auto 10px;
  border-radius: 50%;
  background: rgba(66, 213, 138, 0.12);
  color: #42d58a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kelly-medo-empty strong {
  display: block;
  color: #f3f2f7;
  font-size: 13px;
  margin-bottom: 4px;
}

.kelly-medo-empty span {
  color: #71717c;
  font-size: 12px;
}

/* ---------- Quick actions ---------- */

.kelly-medo-quick-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.kelly-medo-quick-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px;
  border-radius: 14px;
  border: 1px solid #24242e;
  background: #101016;
  transition: transform 0.16s ease, border-color 0.16s ease;
}

.kelly-medo-quick-card:hover {
  transform: translateY(-2px);
  border-color: rgba(139, 92, 246, 0.32);
}

.kelly-medo-quick-icon {
  width: 38px;
  height: 38px;
  min-width: 38px;
  border-radius: 11px;
  background: rgba(139, 92, 246, 0.1);
  color: #a78bfa;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kelly-medo-quick-icon svg {
  width: 18px;
  height: 18px;
}

.kelly-medo-quick-card strong {
  display: block;
  color: #f4f2f8;
  font-size: 13px;
}

.kelly-medo-quick-card span {
  color: #777782;
  font-size: 11px;
}

.kelly-medo-quick-card svg:last-child {
  margin-left: auto;
  width: 16px;
  height: 16px;
  color: #666672;
}

@media (max-width: 900px) {
  .kelly-medo-primary-grid,
  .kelly-medo-quick-grid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   NOTES PAGE
   ========================================================= */

.kelly-notes-page {
  display: grid;
  grid-template-columns: 340px minmax(0, 1fr);
  width: 100%;
  min-height: 100vh;
  background: #0a0a0f;
  color: #f5f3fa;
}

.kelly-notes-list {
  width: 340px;
  min-width: 340px;
  height: 100vh;
  position: sticky;
  top: 0;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 24px 18px;
  background: #0d0d13;
  border-right: 1px solid rgba(255, 255, 255, 0.07);
}

.kelly-notes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 18px;
}

.kelly-notes-header h1 {
  margin: 0;
  color: #f8f7fb;
  font-size: 22px;
  font-weight: 750;
}

.kelly-notes-new {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 0;
  border-radius: 9px;
  background: #7c5cff;
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  padding: 9px 13px;
}

.kelly-notes-search {
  position: relative;
  margin-bottom: 10px;
}

.kelly-notes-search input {
  width: 100%;
  height: 40px;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 10px;
  padding: 0 13px;
  background: #15151d;
  color: #f5f3fa;
  font-size: 12px;
}

.kelly-note-item {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 4px;
  border: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.055);
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.kelly-note-item:hover {
  background: rgba(124, 92, 255, 0.06);
}

.kelly-note-item strong {
  display: block;
  color: #f3f1f8;
  font-size: 13px;
  font-weight: 650;
}

.kelly-note-item .kelly-note-meta {
  display: flex;
  gap: 8px;
  margin-top: 6px;
  font-size: 10.5px;
}

.note-subject-green { color: #42d58a; }
.note-subject-blue { color: #69a8ff; }
.note-subject-orange { color: #f6a04d; }

.kelly-note-reader {
  padding: 34px 42px 60px;
}

.kelly-note-detail-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 30px;
}

.kelly-note-detail-top h1 {
  margin: 0;
  color: #f8f7fb;
  font-size: 30px;
  font-weight: 760;
}

.kelly-detail-meta {
  margin-top: 8px;
  color: #858591;
  font-size: 12px;
}

.kelly-detail-actions {
  display: flex;
  gap: 8px;
}

.kelly-note-action {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 8px;
  padding: 8px 13px;
  background: #15151d;
  color: #d7d5df;
  font-size: 11px;
  font-weight: 650;
}

.kelly-note-delete {
  color: #ff8585;
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.28);
}

.kelly-note-section {
  margin-top: 30px;
}

.kelly-note-section-label {
  color: #777581;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.14em;
  margin-bottom: 10px;
}

.kelly-note-summary {
  color: #c0bec8;
  font-size: 14px;
  line-height: 1.8;
}

.kelly-concept-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.kelly-concept-chip {
  padding: 7px 11px;
  border: 1px solid rgba(124, 92, 255, 0.16);
  border-radius: 999px;
  background: rgba(124, 92, 255, 0.11);
  color: #c5baff;
  font-size: 11px;
  font-weight: 650;
}

.kelly-key-points {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.kelly-key-points li {
  position: relative;
  padding-left: 18px;
  color: #bbb9c4;
  font-size: 13px;
  line-height: 1.7;
}

.kelly-key-points li::before {
  content: "";
  position: absolute;
  left: 2px;
  top: 0.7em;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #7c5cff;
}

.kelly-definitions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.kelly-definition-card {
  padding: 14px 16px;
  border: 1px solid rgba(255, 255, 255, 0.065);
  border-radius: 10px;
  background: #111118;
}

.kelly-definition-term {
  color: #aa96ff;
  font-size: 12px;
  font-weight: 750;
  margin-bottom: 5px;
}

.kelly-definition-text {
  color: #b5b3be;
  font-size: 12px;
  line-height: 1.65;
}

.kelly-takeaways {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.kelly-takeaway {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: #bbb9c4;
  font-size: 13px;
  line-height: 1.65;
}

.kelly-takeaway-check {
  width: 18px;
  height: 18px;
  min-width: 18px;
  border-radius: 50%;
  background: rgba(66, 213, 138, 0.12);
  color: #42d58a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 800;
}

@media (max-width: 900px) {
  .kelly-notes-page {
    grid-template-columns: 1fr;
  }
  .kelly-notes-list {
    width: 100%;
    height: auto;
    max-height: 42vh;
    position: relative;
  }
}
/* ============================================================
   KELLY REACT SHELL
   Migrated from the polished KELLY HTML sidebar.
   Keep this isolated from the existing application styles.
   ============================================================ */

.kelly-app-shell {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  min-height: 100vh;
  display: grid;
  grid-template-columns: 172px minmax(0, 1fr);
  overflow: hidden;
  background: #0a0a0f;
  color: #f4f3f8;
}

.kelly-sidebar {
  width: 172px;
  min-width: 172px;
  max-width: 172px;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;

  display: flex;
  flex-direction: column;

  padding: 20px 10px 12px;

  background: #0a0a0f;
  border-right: 1px solid rgba(139, 92, 246, 0.08);

  overflow: hidden;
}

.kelly-sidebar-logo {
  width: 100%;
  height: 48px;
  min-height: 48px;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 0 9px;
  margin: 0;

  border: 0;
  outline: 0;
  background: transparent;

  color: #ffffff;
  cursor: pointer;

  text-align: left;
}

.kelly-sidebar-logo:hover {
  background: #111118;
  border-radius: 9px;
}

.kelly-sidebar-avatar {
  width: 28px;
  height: 28px;
  flex: 0 0 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 8px;
  background: rgba(139, 92, 246, 0.14);
  color: #a78bfa;
  overflow: hidden;
}

.kelly-sidebar-avatar > * {
  max-width: 28px;
  max-height: 28px;
}

.kelly-sidebar-word {
  font-size: 12px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.kelly-sidebar-level {
  padding: 7px 9px 14px;
}

.kelly-sidebar-level-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 7px;

  font-size: 10px;
  line-height: 1;
}

.kelly-sidebar-level-row span:first-child {
  color: #a78bfa;
  font-weight: 700;
}

.kelly-sidebar-level-row span:last-child {
  color: #777681;
  font-weight: 600;
}

.kelly-sidebar-xp-track {
  width: 100%;
  height: 3px;
  overflow: hidden;
  border-radius: 999px;
  background: #1a1723;
}

.kelly-sidebar-xp-fill {
  width: 48%;
  height: 100%;
  border-radius: inherit;
  background: #8b5cf6;
}

.kelly-sidebar-nav {
  width: 100%;
  flex: 1;
  min-height: 0;

  display: flex;
  flex-direction: column;
  gap: 4px;
}

.kelly-sidebar-link {
  width: 100%;
  min-width: 0;
  min-height: 36px;
  height: 36px;
  box-sizing: border-box;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 8px 9px;
  margin: 0;

  border: none;
  border-left: none;
  border-radius: 9px;
  outline: none;
  box-shadow: none;

  background: transparent;
  color: #878793;

  font-family: inherit;
  font-size: 11px;
  line-height: 1;
  font-weight: 600;

  text-align: left;
  cursor: pointer;

  transition:
    background 120ms ease,
    color 120ms ease;
}

.kelly-sidebar-link:hover:not(:disabled) {
  background: #15151d;
  color: #e8e7ef;
}

.kelly-sidebar-link:disabled {
  opacity: 0.72;
  cursor: default;
}

.kelly-sidebar-link.active,
.kelly-sidebar-link.active:hover {
  background: rgba(139, 92, 246, 0.18);
  color: #ffffff;
  font-weight: 700;

  border: none;
  border-left: none;
  box-shadow: none;
  outline: none;
}

.kelly-sidebar-icon {
  width: 15px;
  height: 15px;
  flex: 0 0 15px;
  color: #87809f;
}

.kelly-sidebar-link.active .kelly-sidebar-icon {
  color: #ffffff;
}

.kelly-sidebar-bottom {
  margin-top: auto;
  padding-top: 10px;

  border-top: 1px solid rgba(139, 92, 246, 0.09);
}

.kelly-app-main {
  min-width: 0;
  min-height: 0;
  height: 100vh;
  overflow: auto;
  background: #0a0a0f;
}

.kelly-page-intro {
  padding: 28px 32px 20px;
}

.kelly-page-intro h1 {
  margin: 0;
  color: #ffffff;
  font-size: 24px;
  font-weight: 750;
}

.kelly-page-intro p {
  margin: 6px 0 0;
  color: #85838f;
  font-size: 13px;
}

@media (max-width: 760px) {
  .kelly-app-shell {
    grid-template-columns: 1fr;
  }

  .kelly-sidebar {
    width: 100%;
    max-width: none;
    min-width: 0;
    height: auto;
    min-height: auto;

    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    top: auto;
    z-index: 50;

    padding: 6px 8px;
    border-right: 0;
    border-top: 1px solid rgba(139, 92, 246, 0.1);
  }

  .kelly-sidebar-logo,
  .kelly-sidebar-level,
  .kelly-sidebar-bottom {
    display: none;
  }

  .kelly-sidebar-nav {
    flex-direction: row;
    gap: 3px;
    justify-content: space-between;
  }

  .kelly-sidebar-link {
    height: 42px;
    min-height: 42px;
    justify-content: center;
    flex-direction: column;
    gap: 3px;
    padding: 4px;
    font-size: 8px;
  }

  .kelly-sidebar-link:nth-child(n + 6) {
    display: none;
  }

  .kelly-sidebar-icon {
    width: 16px;
    height: 16px;
  }

  .kelly-app-main {
    height: 100vh;
    padding-bottom: 54px;
  }
}

/* ============================================================
   KELLY HOME — POLISHED REACT MIGRATION
   Source: public/KELLY/KELLY.html
   ============================================================ */

.kelly-home-page {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;

  padding: 34px 42px 48px;

  background:
    radial-gradient(
      circle at 75% 0%,
      rgba(139, 92, 246, 0.055),
      transparent 34%
    ),
    #0a0a0f;

  color: #f4f3f8;
}

.kelly-home-welcome {
  margin-bottom: 24px;
}

.kelly-home-welcome h1 {
  margin: 0;
  color: #f7f6fb;
  font-size: 25px;
  line-height: 1.2;
  font-weight: 750;
  letter-spacing: -0.02em;
}

.kelly-home-welcome h1 span {
  color: #a78bfa;
}

.kelly-home-welcome p {
  margin: 7px 0 0;
  color: #777681;
  font-size: 12px;
  line-height: 1.5;
}

.kelly-home-card {
  box-sizing: border-box;

  border: 1px solid rgba(139, 92, 246, 0.075);
  border-radius: 12px;

  background: #101016;

  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.012);
}

.kelly-home-level-card {
  padding: 18px 20px 15px;
  margin-bottom: 12px;
}

.kelly-home-level-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.kelly-home-level-title {
  display: flex;
  align-items: center;
  gap: 12px;
}

.kelly-home-trophy {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;
  background: rgba(139, 92, 246, 0.1);

  font-size: 17px;
}

.kelly-home-level-number {
  color: #f4f3f8;
  font-size: 14px;
  font-weight: 750;
}

.kelly-home-level-next {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
}

.kelly-home-level-next strong {
  color: #a78bfa;
  font-size: 13px;
  font-weight: 750;
}

.kelly-home-level-next span {
  color: #6f6d77;
  font-size: 9px;
}

.kelly-home-xp-track {
  width: 100%;
  height: 5px;
  margin-top: 16px;

  overflow: hidden;
  border-radius: 999px;

  background: #1a1821;
}

.kelly-home-xp-fill {
  width: 48%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(
    90deg,
    #7c3aed,
    #a78bfa
  );
}

.kelly-home-level-bottom {
  display: flex;
  justify-content: space-between;

  margin-top: 9px;

  color: #686670;
  font-size: 9px;
}

.kelly-home-level-bottom strong {
  color: #9a98a3;
  font-weight: 700;
}

.kelly-home-stat-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 12px;
}

.kelly-home-stat-card {
  padding: 15px 16px 14px;
}

.kelly-home-stat-icon {
  width: 27px;
  height: 27px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 12px;

  border-radius: 7px;
  background: rgba(139, 92, 246, 0.08);

  color: #a78bfa;
  font-size: 13px;
}

.kelly-home-stat-name {
  color: #777681;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.kelly-home-stat-value {
  margin-top: 5px;

  color: #f3f2f7;
  font-size: 19px;
  line-height: 1;
  font-weight: 750;
  letter-spacing: -0.02em;
}

.kelly-home-stat-label {
  margin-top: 5px;

  color: #5f5d68;
  font-size: 8px;
}

.kelly-home-two-col {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 12px;
  margin-bottom: 12px;
}

.kelly-home-content-card {
  min-width: 0;
  padding: 17px 18px;
}

.kelly-home-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  margin-bottom: 14px;
}

.kelly-home-section-label {
  color: #706e7b;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.kelly-home-link {
  padding: 0;

  border: 0;
  background: transparent;

  color: #9b7bea;
  font-family: inherit;
  font-size: 9px;
  font-weight: 650;

  text-decoration: none;
  cursor: pointer;
}

.kelly-home-link:hover:not(:disabled) {
  color: #c4b5fd;
}

.kelly-home-link:disabled {
  opacity: 0.5;
  cursor: default;
}

.kelly-home-button-reset {
  appearance: none;
}

.kelly-home-note-list,
.kelly-home-upcoming-list {
  display: flex;
  flex-direction: column;
}

.kelly-home-note-row {
  min-height: 50px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  padding: 9px 0;

  border: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.035);

  background: transparent;

  color: inherit;
  font-family: inherit;
  text-align: left;
  text-decoration: none;

  cursor: pointer;
}

.kelly-home-note-row:first-child {
  border-top: 0;
}

.kelly-home-note-row:hover strong {
  color: #c4b5fd;
}

.kelly-home-note-row > div {
  min-width: 0;

  display: flex;
  flex-direction: column;
  gap: 4px;
}

.kelly-home-note-row strong {
  color: #dedce6;
  font-size: 10px;
  font-weight: 700;

  transition: color 120ms ease;
}

.kelly-home-note-row span {
  color: #66646f;
  font-size: 8px;
}

.kelly-home-arrow {
  flex: 0 0 auto;
  color: #66616f !important;
  font-size: 13px !important;
}

.kelly-home-upcoming-row {
  width: 100%;
  min-height: 47px;

  display: flex;
  align-items: stretch;
  gap: 11px;

  padding: 8px 0;

  border: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.035);

  background: transparent;

  color: inherit;
  font-family: inherit;
  text-align: left;

  cursor: pointer;
}

.kelly-home-upcoming-row:first-child {
  border-top: 0;
}

.kelly-home-upcoming-row:hover .kelly-home-upcoming-copy strong {
  color: #c4b5fd;
}

.kelly-home-upcoming-bar {
  width: 3px;
  flex: 0 0 3px;

  border-radius: 999px;
}

.kelly-home-upcoming-bar.green {
  background: #5ee7a5;
}

.kelly-home-upcoming-bar.red {
  background: #f26d85;
}

.kelly-home-upcoming-copy {
  min-width: 0;

  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
}

.kelly-home-upcoming-copy strong {
  color: #dedce6;
  font-size: 10px;
  font-weight: 700;

  transition: color 120ms ease;
}

.kelly-home-upcoming-copy span {
  color: #66646f;
  font-size: 8px;
}

.kelly-home-quiz-name {
  margin-top: 2px;

  color: #e7e5ed;
  font-size: 14px;
  font-weight: 700;
}

.kelly-home-quiz-summary {
  display: flex;
  gap: 44px;

  margin-top: 20px;
}

.kelly-home-quiz-summary > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.kelly-home-quiz-summary strong {
  font-size: 21px;
  line-height: 1;
  font-weight: 750;
}

.kelly-home-score {
  color: #a78bfa;
}

.kelly-home-quiz-xp {
  color: #68e0a4;
}

.kelly-home-quiz-summary span {
  color: #62606b;
  font-size: 7px;
  font-weight: 750;
  letter-spacing: 0.09em;
}

.kelly-home-friend-row {
  display: flex;
  align-items: center;
  gap: 11px;

  padding-top: 4px;
}

.kelly-home-friend-avatar {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;
  background: rgba(139, 92, 246, 0.16);

  color: #b59bf8;
  font-size: 11px;
  font-weight: 750;
}

.kelly-home-friend-row > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.kelly-home-friend-row strong {
  color: #dedce6;
  font-size: 10px;
}

.kelly-home-studying {
  color: #66646f;
  font-size: 8px;
}

.kelly-home-quick-wrap {
  padding-top: 3px;
}

.kelly-home-quick-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;

  margin-top: 10px;
}

.kelly-home-quick-action {
  min-height: 68px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;

  padding: 12px;

  border: 1px solid rgba(139, 92, 246, 0.07);
  border-radius: 10px;

  background: #101016;

  color: #dcd9e5;
  font-family: inherit;
  text-decoration: none;

  cursor: pointer;

  transition:
    background 120ms ease,
    border-color 120ms ease,
    transform 120ms ease;
}

.kelly-home-quick-action:hover:not(:disabled) {
  background: #14141c;
  border-color: rgba(139, 92, 246, 0.16);
  transform: translateY(-1px);
}

.kelly-home-quick-action:disabled {
  opacity: 0.52;
  cursor: default;
}

.kelly-home-quick-icon {
  width: 28px;
  height: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 7px;
  background: rgba(139, 92, 246, 0.09);

  color: #a78bfa;
  font-size: 12px;
}

.kelly-home-quick-action strong {
  font-size: 9px;
  font-weight: 700;
}

.kelly-home-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 24px;

  background: rgba(0, 0, 0, 0.62);
  backdrop-filter: blur(5px);
}

.kelly-home-modal {
  width: min(440px, 100%);

  padding: 22px;

  border: 1px solid rgba(139, 92, 246, 0.14);
  border-radius: 14px;

  background: #111118;

  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
}

.kelly-home-modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;

  margin-bottom: 20px;
}

.kelly-home-modal-head h2 {
  margin: 7px 0 0;

  color: #f3f2f7;
  font-size: 18px;
  font-weight: 750;
}

.kelly-home-modal-close {
  width: 30px;
  height: 30px;

  border: 0;
  border-radius: 8px;

  background: #191920;
  color: #8a8792;

  font-size: 20px;
  line-height: 1;

  cursor: pointer;
}

.kelly-home-modal-close:hover {
  color: #ffffff;
}

.kelly-home-deadline-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.kelly-home-deadline-form label {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.kelly-home-deadline-form label > span {
  color: #85828e;
  font-size: 9px;
  font-weight: 700;
}

.kelly-home-deadline-form input {
  width: 100%;
  box-sizing: border-box;

  padding: 10px 11px;

  border: 1px solid rgba(139, 92, 246, 0.1);
  border-radius: 8px;

  outline: none;

  background: #0b0b10;
  color: #eeeef4;

  font: inherit;
  font-size: 11px;
}

.kelly-home-deadline-form input::placeholder {
  color: #4f4d57;
}

.kelly-home-deadline-form input:focus {
  border-color: rgba(139, 92, 246, 0.4);
}

.kelly-home-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;

  margin-top: 5px;
}

.kelly-home-modal-cancel,
.kelly-home-modal-save {
  min-height: 34px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  padding: 7px 12px;

  border-radius: 8px;

  font-family: inherit;
  font-size: 10px;
  font-weight: 700;

  cursor: pointer;
}

.kelly-home-modal-cancel {
  border: 1px solid rgba(255, 255, 255, 0.07);
  background: transparent;
  color: #85828e;
}

.kelly-home-modal-save {
  border: 1px solid rgba(139, 92, 246, 0.18);
  background: #7c3aed;
  color: #ffffff;
}

.kelly-home-modal-save:hover {
  background: #8b5cf6;
}

.kelly-home-modal-save svg {
  width: 13px;
  height: 13px;
}

@media (max-width: 900px) {
  .kelly-home-page {
    padding: 28px 24px 80px;
  }

  .kelly-home-stat-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .kelly-home-two-col {
    grid-template-columns: 1fr;
  }

  .kelly-home-quick-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .kelly-home-page {
    padding: 22px 15px 76px;
  }

  .kelly-home-welcome h1 {
    font-size: 21px;
  }

  .kelly-home-stat-row {
    gap: 8px;
  }

  .kelly-home-stat-card {
    padding: 13px;
  }

  .kelly-home-level-top {
    align-items: flex-start;
  }

  .kelly-home-level-next {
    text-align: right;
  }

  .kelly-home-quick-row {
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .kelly-home-quick-action {
    min-height: 60px;
  }
}

/* ============================================================
   KELLY LANDING — REACT ROOT
   ============================================================ */

.kelly-landing {
  position: relative;

  width: 100%;
  min-height: 100vh;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 72% 48%,
      rgba(124, 58, 237, 0.11),
      transparent 32%
    ),
    radial-gradient(
      circle at 15% 10%,
      rgba(139, 92, 246, 0.06),
      transparent 28%
    ),
    #0a0a0f;

  color: #f5f3fa;
}

.kelly-landing-grid {
  position: absolute;
  inset: 0;

  opacity: 0.22;
  pointer-events: none;

  background-image:
    linear-gradient(
      rgba(139, 92, 246, 0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(139, 92, 246, 0.025) 1px,
      transparent 1px
    );

  background-size: 52px 52px;

  mask-image: linear-gradient(
    to bottom,
    black,
    transparent 82%
  );
}

.kelly-landing-orb {
  position: absolute;

  width: 420px;
  height: 420px;

  border-radius: 50%;

  filter: blur(100px);

  pointer-events: none;
}

.kelly-landing-orb-one {
  top: -180px;
  right: -100px;

  background: rgba(124, 58, 237, 0.08);
}

.kelly-landing-orb-two {
  bottom: -220px;
  left: -180px;

  background: rgba(99, 102, 241, 0.05);
}

.kelly-landing-nav {
  position: relative;
  z-index: 5;

  height: 76px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 42px;
}

.kelly-landing-brand {
  display: flex;
  align-items: center;
  gap: 10px;

  color: inherit;
  text-decoration: none;
}

.kelly-landing-brand-mark {
  width: 35px;
  height: 35px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(139, 92, 246, 0.18);
  border-radius: 10px;

  background: rgba(139, 92, 246, 0.08);
}

.kelly-landing-brand > span:last-child {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.kelly-landing-brand strong {
  color: #f1eff6;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.kelly-landing-brand small {
  color: #66636f;
  font-size: 7px;
}

.kelly-landing-login {
  padding: 8px 13px;

  border: 1px solid rgba(139, 92, 246, 0.13);
  border-radius: 8px;

  background: rgba(139, 92, 246, 0.045);

  color: #aaa6b6;
  font-size: 10px;
  font-weight: 700;

  text-decoration: none;

  transition:
    color 120ms ease,
    background 120ms ease;
}

.kelly-landing-login:hover {
  background: rgba(139, 92, 246, 0.1);
  color: #ddd8ea;
}

.kelly-landing-hero {
  position: relative;
  z-index: 2;

  width: min(1080px, calc(100% - 84px));
  min-height: calc(100vh - 76px);

  margin: 0 auto;

  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(360px, 0.9fr);
  align-items: center;
  gap: 70px;
}

.kelly-landing-copy {
  max-width: 520px;
}

.kelly-landing-pill {
  width: fit-content;

  display: inline-flex;
  align-items: center;
  gap: 7px;

  padding: 6px 10px;

  border: 1px solid rgba(139, 92, 246, 0.13);
  border-radius: 999px;

  background: rgba(139, 92, 246, 0.055);

  color: #9c8bbd;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.kelly-landing-pill svg {
  width: 11px;
  height: 11px;
  color: #a78bfa;
}

.kelly-landing-copy h1 {
  margin: 20px 0 14px;

  color: #f6f4fa;

  font-size: clamp(38px, 5vw, 62px);
  line-height: 0.98;
  font-weight: 800;
  letter-spacing: -0.045em;
}

.kelly-landing-copy h1 span {
  color: #a78bfa;
}

.kelly-landing-copy > p {
  max-width: 465px;

  margin: 0;

  color: #777480;

  font-size: 13px;
  line-height: 1.75;
}

.kelly-landing-actions {
  display: flex;
  align-items: center;
  gap: 12px;

  margin-top: 28px;
}

.kelly-landing-primary,
.kelly-landing-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  min-height: 38px;

  padding: 9px 14px;

  border-radius: 9px;

  font-size: 9px;
  font-weight: 750;

  text-decoration: none;
}

.kelly-landing-primary {
  border: 1px solid rgba(139, 92, 246, 0.25);
  background: #7c3aed;
  color: #fff;
}

.kelly-landing-primary:hover {
  background: #8b5cf6;
}

.kelly-landing-primary svg {
  width: 12px;
  height: 12px;
}

.kelly-landing-secondary {
  border: 1px solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.025);
  color: #777480;
}

.kelly-landing-secondary:hover {
  color: #aaa6b6;
  background: rgba(255, 255, 255, 0.04);
}

.kelly-landing-character {
  position: relative;

  height: 480px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.kelly-landing-glow {
  position: absolute;

  width: 300px;
  height: 300px;

  border-radius: 50%;

  background: rgba(124, 58, 237, 0.1);

  filter: blur(65px);
}

.kelly-landing-ring {
  position: absolute;

  border: 1px solid rgba(139, 92, 246, 0.11);
  border-radius: 50%;

  pointer-events: none;
}

.kelly-landing-ring.ring-one {
  width: 340px;
  height: 340px;
}

.kelly-landing-ring.ring-two {
  width: 430px;
  height: 430px;

  border-color: rgba(139, 92, 246, 0.055);
}

.kelly-landing-character-card {
  position: relative;
  z-index: 2;

  width: 190px;
  height: 190px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(139, 92, 246, 0.16);
  border-radius: 38px;

  background:
    radial-gradient(
      circle at 50% 35%,
      rgba(139, 92, 246, 0.12),
      transparent 65%
    ),
    #101016;

  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
}

.kelly-landing-floating-card {
  position: absolute;
  z-index: 4;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 10px 12px;

  border: 1px solid rgba(139, 92, 246, 0.09);
  border-radius: 10px;

  background: rgba(16, 16, 22, 0.88);

  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);

  backdrop-filter: blur(12px);
}

.kelly-landing-floating-card svg {
  width: 14px;
  height: 14px;

  color: #a78bfa;
}

.kelly-landing-floating-card span {
  display: flex;
  flex-direction: column;
  gap: 2px;

  color: #65626d;

  font-size: 7px;
}

.kelly-landing-floating-card strong {
  color: #ddd9e7;
  font-size: 9px;
}

.kelly-landing-floating-card.floating-one {
  top: 94px;
  right: 10px;
}

.kelly-landing-floating-card.floating-two {
  bottom: 98px;
  left: 15px;
}

@media (max-width: 800px) {
  .kelly-landing-nav {
    padding: 0 20px;
  }

  .kelly-landing-hero {
    width: calc(100% - 40px);
    min-height: auto;

    grid-template-columns: 1fr;

    padding: 45px 0 80px;

    gap: 35px;
  }

  .kelly-landing-copy {
    max-width: none;
    text-align: center;
  }

  .kelly-landing-pill {
    margin: 0 auto;
  }

  .kelly-landing-copy > p {
    margin-left: auto;
    margin-right: auto;
  }

  .kelly-landing-actions {
    justify-content: center;
    flex-wrap: wrap;
  }

  .kelly-landing-character {
    height: 350px;
  }

  .kelly-landing-ring.ring-one {
    width: 260px;
    height: 260px;
  }

  .kelly-landing-ring.ring-two {
    width: 330px;
    height: 330px;
  }

  .kelly-landing-character-card {
    width: 150px;
    height: 150px;
    border-radius: 30px;
  }
}

/* =========================================================
   KELLY REACT LANDING PAGE
   Migrated from the original KELLY landing page.
   ========================================================= */

.kelly-landing {
  min-height: 100vh;
  background: #fcfbff;
  color: #19172a;
}

.kelly-landing button {
  font-family: inherit;
}

.kelly-landing .site-nav {
  position: sticky;
  top: 0;
  z-index: 80;
  background: rgba(252, 251, 255, 0.86);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid #e8e5f1;
}

.kelly-landing .nav-inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 16px 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.kelly-landing .nav-links {
  display: flex;
  align-items: center;
  gap: 30px;
}

.kelly-landing .nav-actions {
  display: flex;
  align-items: center;
  gap: 14px;
}

.kelly-landing .logo {
  border: 0;
  background: transparent;
  padding: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
}

.kelly-landing .logo-word {
  font-size: 16px;
  font-weight: 900;
  letter-spacing: 0.13em;
}

.kelly-landing .nav-link {
  border: 0;
  background: transparent;
  color: #635f78;
  font-size: 13px;
  font-weight: 650;
  cursor: pointer;
  padding: 7px 2px;
}

.kelly-landing .nav-link:hover {
  color: #27233d;
}

.kelly-landing .hero {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(760px 480px at 82% -8%, rgba(255, 176, 32, 0.16), transparent 60%),
    radial-gradient(900px 620px at 8% 8%, rgba(139, 130, 255, 0.30), transparent 55%),
    linear-gradient(168deg, #201b42 0%, #1a1730 55%, #15122a 100%);
  padding: 76px 0 0;
}

.kelly-landing .hero-inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 32px;
  display: grid;
  grid-template-columns: 1.02fr 0.98fr;
  gap: 20px;
  align-items: center;
}

.kelly-landing .hero-copy h1 {
  font-size: 56px;
  color: #fff;
  line-height: 1.06;
  margin: 18px 0 22px;
  max-width: 15ch;
}

.kelly-landing .hero-lede {
  color: #c8c2ee;
  font-size: 18px;
  line-height: 1.6;
  max-width: 46ch;
  margin-bottom: 34px;
}

.kelly-landing .hero-actions {
  display: flex;
  gap: 14px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 20px;
}

.kelly-landing .hero-note {
  color: #8f87c4;
  font-size: 13.5px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.kelly-landing .hero-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420px;
}

.kelly-landing .hero-visual .glow {
  position: absolute;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 176, 32, 0.22), transparent 68%);
  filter: blur(2px);
}

.kelly-landing .hero-chip {
  position: absolute;
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 18px 55px rgba(21, 18, 42, 0.18);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13.5px;
  font-weight: 700;
  color: #19172a;
  z-index: 3;
}

.kelly-landing .hero-chip-1 {
  left: 0;
  top: 72px;
}

.kelly-landing .hero-chip-2 {
  right: 0;
  bottom: 60px;
}

.kelly-landing .hero-mascot-wrap {
  position: relative;
  z-index: 2;
  animation: kellyLandingFloat 5.5s ease-in-out infinite;
}

@keyframes kellyLandingFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12px);
  }
}

.kelly-landing .container {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 32px;
}

.kelly-landing .landing-process-container {
  position: relative;
}

.kelly-landing .process-strip {
  position: relative;
  z-index: 5;
  margin-top: 56px;
  margin-bottom: -58px;
  background: #fff;
  border-radius: 24px;
  box-shadow: 0 18px 55px rgba(21, 18, 42, 0.18);
  padding: 26px 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  overflow-x: auto;
}

.kelly-landing .process-step {
  display: flex;
  align-items: center;
  gap: 9px;
  white-space: nowrap;
  color: #29253e;
  font-size: 14px;
}

.kelly-landing .process-step span {
  font-size: 20px;
}

.kelly-landing .process-arrow {
  color: #aaa5bd;
  font-size: 20px;
}

.kelly-landing .hero-spacer {
  height: 58px;
}

.kelly-landing .section {
  padding: 96px 0;
}

.kelly-landing .section-tint {
  background: #f7f5fb;
}

.kelly-landing .kelly-intro {
  display: grid;
  grid-template-columns: 0.92fr 1.08fr;
  gap: 64px;
  align-items: center;
}

.kelly-landing .kelly-intro-copy h2 {
  font-size: 40px;
  margin: 18px 0 20px;
}

.kelly-landing .kelly-intro-copy p {
  font-size: 17px;
  color: #68637b;
  line-height: 1.75;
  margin-bottom: 16px;
  max-width: 48ch;
}

.kelly-landing .kelly-intro-copy p strong {
  color: #19172a;
}

.kelly-landing .kelly-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420px;
}

.kelly-landing .kelly-stage-bg {
  position: absolute;
  width: 340px;
  height: 340px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(139, 130, 255, 0.16), transparent 68%);
}

.kelly-landing .landing-stage-avatar {
  position: relative;
  z-index: 2;
}

.kelly-landing .speech-bubble {
  position: absolute;
  background: #fff;
  border-radius: 20px;
  padding: 14px 18px;
  box-shadow: 0 10px 35px rgba(21, 18, 42, 0.12);
  font-size: 14.5px;
  font-weight: 600;
  color: #19172a;
  max-width: 210px;
  line-height: 1.4;
  border: 1px solid #e8e5f1;
  z-index: 4;
}

.kelly-landing .speech-bubble.b1 {
  top: 16px;
  left: 0;
}

.kelly-landing .speech-bubble.b2 {
  right: 0;
  top: 112px;
}

.kelly-landing .speech-bubble.b3 {
  left: 12px;
  bottom: 24px;
}

.kelly-landing .section-head {
  max-width: 640px;
  margin-bottom: 56px;
}

.kelly-landing .section-head h2 {
  font-size: 40px;
  margin: 18px 0 14px;
}

.kelly-landing .section-head p {
  font-size: 17px;
  line-height: 1.7;
  color: #68637b;
}

.kelly-landing .eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #68637b;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.kelly-landing .eyebrow.gold {
  color: #ffb020;
}

.kelly-landing .eyebrow.mint {
  color: #55a88d;
}

.kelly-landing .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
}

.kelly-landing .flow-list {
  position: relative;
  max-width: 760px;
}

.kelly-landing .flow-list::before {
  content: "";
  position: absolute;
  left: 23px;
  top: 26px;
  bottom: 26px;
  width: 1px;
  background: #dcd8e8;
}

.kelly-landing .landing-flow-item {
  position: relative;
  display: grid;
  grid-template-columns: 48px 58px 1fr;
  gap: 18px;
  align-items: center;
  padding: 20px 0;
}

.kelly-landing .landing-flow-number {
  position: relative;
  z-index: 2;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid #e4e0ed;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #756e92;
  font-size: 12px;
  font-weight: 800;
}

.kelly-landing .landing-flow-icon {
  font-size: 27px;
}

.kelly-landing .landing-flow-item h3 {
  margin: 0 0 6px;
  font-size: 18px;
}

.kelly-landing .landing-flow-item p {
  margin: 0;
  color: #68637b;
  line-height: 1.6;
}

.kelly-landing .bento-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.kelly-landing .landing-feature-card {
  min-height: 180px;
  border: 1px solid #e8e5f1;
  border-radius: 22px;
  background: #fff;
  padding: 24px;
  box-shadow: 0 8px 30px rgba(21, 18, 42, 0.05);
}

.kelly-landing .landing-feature-card.large {
  grid-column: span 2;
}

.kelly-landing .landing-feature-icon {
  font-size: 26px;
  margin-bottom: 22px;
}

.kelly-landing .landing-feature-card h3 {
  margin: 0 0 8px;
  font-size: 18px;
}

.kelly-landing .landing-feature-card p {
  margin: 0;
  color: #68637b;
  line-height: 1.55;
}

.kelly-landing .social-band {
  background: linear-gradient(165deg, #231d48, #1a1730);
  color: #fff;
  padding: 100px 0;
  position: relative;
  overflow: hidden;
}

.kelly-landing .social-band::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(
    600px 400px at 90% 10%,
    rgba(255, 176, 32, 0.14),
    transparent 60%
  );
}

.kelly-landing .social-inner {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 0.92fr;
  gap: 64px;
  align-items: center;
}

.kelly-landing .social-copy h2 {
  font-size: 40px;
  margin: 18px 0 16px;
}

.kelly-landing .social-copy > p {
  color: #c8c2ee;
  font-size: 17px;
  line-height: 1.7;
  max-width: 52ch;
}

.kelly-landing .social-eyebrow {
  background: rgba(255, 176, 32, 0.14);
  padding: 7px 11px;
  border-radius: 999px;
}

.kelly-landing .social-feature-grid {
  display: grid;
  gap: 16px;
  margin: 30px 0;
}

.kelly-landing .social-feature {
  display: flex;
  gap: 13px;
  align-items: flex-start;
}

.kelly-landing .social-feature > span {
  font-size: 23px;
}

.kelly-landing .social-feature strong {
  display: block;
  margin-bottom: 3px;
}

.kelly-landing .social-feature p {
  margin: 0;
  color: #9f98ca;
  font-size: 14px;
}

.kelly-landing .social-visual {
  position: relative;
  padding: 20px 34px 60px 0;
}

.kelly-landing .lb-preview {
  background: #fff;
  color: #19172a;
  border-radius: 20px;
  padding: 22px;
  box-shadow: 0 18px 55px rgba(0, 0, 0, 0.24);
  position: relative;
  z-index: 2;
}

.kelly-landing .lbp-head {
  font-size: 13px;
  color: #68637b;
  font-weight: 800;
  margin-bottom: 14px;
}

.kelly-landing .lb-preview-row {
  display: grid;
  grid-template-columns: 25px 32px 1fr auto;
  align-items: center;
  gap: 9px;
  padding: 11px 0;
  border-bottom: 1px solid #efedf4;
  font-size: 13px;
}

.kelly-landing .lb-preview-row:last-child {
  border-bottom: 0;
}

.kelly-landing .lb-rank {
  color: #9a94ad;
  font-weight: 800;
}

.kelly-landing .lb-avatar,
.kelly-landing .cp-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eeeaff;
  color: #6b55bd;
  font-weight: 800;
}

.kelly-landing .lb-xp {
  color: #766f8c;
  font-size: 12px;
}

.kelly-landing .challenge-preview {
  background: #fff;
  color: #19172a;
  border-radius: 20px;
  box-shadow: 0 18px 55px rgba(0, 0, 0, 0.24);
  padding: 20px;
  width: 260px;
  position: absolute;
  right: -34px;
  bottom: -46px;
  z-index: 3;
  transform: rotate(3deg);
}

.kelly-landing .cp-top {
  display: flex;
  align-items: center;
  gap: 10px;
}

.kelly-landing .challenge-preview > p {
  font-size: 13.5px;
  line-height: 1.5;
  margin: 14px 0 10px;
}

.kelly-landing .cp-meta {
  color: #766f8c;
  font-size: 12px;
  margin-bottom: 14px;
}

.kelly-landing .cta-band {
  padding: 100px 0;
  text-align: center;
}

.kelly-landing .cta-band h2 {
  font-size: 40px;
  max-width: 20ch;
  margin: 0 auto 16px;
}

.kelly-landing .cta-band p {
  color: #68637b;
  font-size: 17px;
  margin-bottom: 32px;
}

.kelly-landing .cta-mascot-row {
  margin-bottom: 20px;
}

.kelly-landing .site-footer {
  background: #19172a;
  color: #fff;
  padding: 64px 0 28px;
}

.kelly-landing .footer-top {
  display: flex;
  justify-content: space-between;
  gap: 40px;
  padding-bottom: 44px;
  border-bottom: 1px solid rgba(255,255,255,.12);
  flex-wrap: wrap;
}

.kelly-landing .footer-brand {
  max-width: 280px;
}

.kelly-landing .footer-brand-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.kelly-landing .footer-brand p {
  color: #aaa5bd;
  line-height: 1.65;
  font-size: 14px;
  margin-top: 16px;
}

.kelly-landing .footer-cols {
  display: flex;
  gap: 56px;
  flex-wrap: wrap;
}

.kelly-landing .footer-col {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 110px;
}

.kelly-landing .footer-col h4 {
  margin: 0 0 8px;
  font-size: 13px;
}

.kelly-landing .footer-col button {
  background: transparent;
  border: 0;
  padding: 0;
  color: #aaa5bd;
  text-align: left;
  font-size: 13px;
  cursor: pointer;
}

.kelly-landing .footer-col button:hover {
  color: #fff;
}

.kelly-landing .footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 22px;
  color: #726c9c;
  font-size: 13px;
  flex-wrap: wrap;
  gap: 10px;
}

@media (max-width: 900px) {
  .kelly-landing .nav-links {
    display: none;
  }

  .kelly-landing .hero-inner,
  .kelly-landing .kelly-intro,
  .kelly-landing .social-inner {
    grid-template-columns: 1fr;
  }

  .kelly-landing .hero-copy h1 {
    font-size: 46px;
  }

  .kelly-landing .hero-visual {
    min-height: 380px;
  }

  .kelly-landing .bento-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .kelly-landing .landing-feature-card.large {
    grid-column: span 2;
  }

  .kelly-landing .social-visual {
    max-width: 620px;
  }
}

@media (max-width: 620px) {
  .kelly-landing .nav-inner,
  .kelly-landing .hero-inner,
  .kelly-landing .container {
    padding-left: 20px;
    padding-right: 20px;
  }

  .kelly-landing .nav-actions {
    gap: 7px;
  }

  .kelly-landing .nav-actions .btn {
    padding-left: 12px;
    padding-right: 12px;
  }

  .kelly-landing .hero {
    padding-top: 48px;
  }

  .kelly-landing .hero-copy h1 {
    font-size: 39px;
  }

  .kelly-landing .hero-lede {
    font-size: 16px;
  }

  .kelly-landing .hero-chip {
    font-size: 11px;
    padding: 9px 11px;
  }

  .kelly-landing .hero-chip-1 {
    left: -4px;
    top: 50px;
  }

  .kelly-landing .hero-chip-2 {
    right: -4px;
    bottom: 36px;
  }

  .kelly-landing .process-strip {
    padding: 20px;
    justify-content: flex-start;
  }

  .kelly-landing .process-arrow {
    display: none;
  }

  .kelly-landing .section {
    padding: 72px 0;
  }

  .kelly-landing .section-head h2,
  .kelly-landing .kelly-intro-copy h2,
  .kelly-landing .social-copy h2,
  .kelly-landing .cta-band h2 {
    font-size: 32px;
  }

  .kelly-landing .speech-bubble {
    font-size: 12px;
    max-width: 155px;
    padding: 10px 12px;
  }

  .kelly-landing .speech-bubble.b1 {
    top: 10px;
  }

  .kelly-landing .speech-bubble.b2 {
    right: -2px;
    top: 100px;
  }

  .kelly-landing .speech-bubble.b3 {
    left: 0;
    bottom: 5px;
  }

  .kelly-landing .bento-grid {
    grid-template-columns: 1fr;
  }

  .kelly-landing .landing-feature-card.large {
    grid-column: span 1;
  }

  .kelly-landing .social-visual {
    padding-right: 0;
  }

  .kelly-landing .challenge-preview {
    right: -5px;
    width: 230px;
  }

  .kelly-landing .footer-cols {
    gap: 30px;
  }
}
 /* ---------- LISTEN & TRANSCRIBE ---------- */

.kelly-listen-page {
  min-height: 100%;
  padding: 34px 38px 50px;
  background: #0a0a0f;
  color: #f8f7fb;
  font-family: var(--font-body);
}

.kelly-listen-header {
  margin-bottom: 28px;
}

.kelly-listen-header h1 {
  margin: 0;
  color: #f8f7fb;
  font-family: var(--font-display);
  font-size: 24px;
  line-height: 1.15;
  font-weight: 700;
  letter-spacing: -0.035em;
}

.kelly-listen-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  gap: 16px;
  align-items: stretch;
}

.kelly-listen-card {
  min-height: 420px;
  padding: 22px;
  box-sizing: border-box;
  background: #101016;
  border: 1px solid #24242e;
  border-radius: 14px;
  box-shadow:
    0 12px 32px rgba(0, 0, 0, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.018);
}

.kelly-listen-card-header h2 {
  margin: 0;
  color: #f5f4fa;
  font-family: var(--font-display);
  font-size: 15px;
  line-height: 1.3;
  font-weight: 700;
}

.kelly-listen-divider {
  height: 1px;
  margin: 17px 0 18px;
  background: rgba(255, 255, 255, 0.07);
}

/* Subject */

.kelly-listen-field {
  display: block;
  width: 100%;
}

.kelly-listen-select-wrap {
  position: relative;
  width: 100%;
}

.kelly-listen-select {
  width: 100%;
  height: 42px;
  padding: 0 42px 0 13px;
  appearance: none;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 10px;
  outline: none;
  background: #15151d;
  color: #f5f3fa;
  font-family: var(--font-body);
  font-size: 12px;
  cursor: pointer;
}

.kelly-listen-select:focus {
  border-color: var(--violet);
  box-shadow: 0 0 0 3px rgba(91, 78, 240, 0.10);
}

.kelly-listen-select:disabled {
  opacity: 0.72;
  cursor: default;
}

.kelly-listen-select-icon {
  position: absolute;
  top: 50%;
  right: 13px;
  pointer-events: none;
  color: #686875;
  transform: translateY(-50%);
}

/* Recorder */

.kelly-listen-recorder-center {
  display: flex;
  min-height: 270px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.kelly-listen-timer {
  color: #ffffff;
  font-family: var(--font-body);
  font-size: 64px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -0.045em;
}

.kelly-listen-status {
  margin: 11px 0 0;
  color: #777782;
  font-family: var(--font-body);
  font-size: 12px;
  line-height: 1.4;
}

.kelly-listen-waveform {
  display: flex;
  width: min(92%, 500px);
  height: 24px;
  margin: 25px 0 27px;
  align-items: center;
  justify-content: space-between;
  gap: 4px;
}

.kelly-listen-waveform span {
  display: block;
  flex: 1;
  min-width: 2px;
  max-width: 5px;
  height: 2px !important;
  border-radius: 999px;
  background: var(--violet);
  opacity: 0.20;
  transition: height 180ms ease, opacity 180ms ease;
}

.kelly-listen-waveform.is-recording span {
  opacity: 0.72;
  animation: kelly-listen-wave 900ms ease-in-out infinite alternate;
}

.kelly-listen-waveform.is-recording span:nth-child(3n) {
  animation-delay: -250ms;
}

.kelly-listen-waveform.is-recording span:nth-child(4n) {
  animation-delay: -500ms;
}

@keyframes kelly-listen-wave {
  from {
    transform: scaleY(0.45);
  }

  to {
    transform: scaleY(1.65);
  }
}

/* Button */

.kelly-listen-record-button {
  display: inline-flex;
  min-height: 42px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 19px;
  border: 0;
  border-radius: var(--r-pill);
  background: var(--violet);
  color: #ffffff;
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
  box-shadow: var(--shadow-violet);
  transition:
    background 120ms ease,
    transform 120ms ease,
    box-shadow 120ms ease;
}

.kelly-listen-record-button:hover {
  background: var(--violet-dk);
  transform: translateY(-1px);
}

.kelly-listen-record-button:active {
  transform: translateY(0);
}

.kelly-listen-record-button.is-recording {
  background: var(--violet-dk);
}

/* Live Transcript */

.kelly-listen-transcript {
  display: flex;
  flex-direction: column;
}

.kelly-listen-transcript-empty {
  flex: 1;
  display: flex;
  min-height: 320px;
  align-items: center;
  justify-content: center;
  padding: 20px;
  text-align: center;
}

.kelly-listen-transcript-empty p {
  margin: 0;
  max-width: 240px;
  color: #777782;
  font-family: var(--font-body);
  font-size: 12px;
  line-height: 1.5;
}

/* Previous recordings */

.kelly-listen-history {
  margin-top: 27px;
}

.kelly-listen-history-label {
  margin-bottom: 12px;
  color: #767681;
  font-family: var(--font-body);
  font-size: 10px;
  line-height: 1.4;
  font-weight: 700;
  letter-spacing: 0.13em;
}

.kelly-listen-recordings {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.kelly-listen-recording-row {
  display: flex;
  min-height: 70px;
  align-items: center;
  gap: 13px;
  padding: 13px 15px;
  box-sizing: border-box;
  background: #101016;
  border: 1px solid #24242e;
  border-radius: 14px;
}

.kelly-listen-recording-icon {
  display: flex;
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  background: rgba(91, 78, 240, 0.12);
  color: var(--violet-lt);
}

.kelly-listen-recording-info {
  min-width: 0;
}

.kelly-listen-recording-info strong {
  display: block;
  overflow: hidden;
  color: #f3f2f7;
  font-family: var(--font-body);
  font-size: 13px;
  line-height: 1.4;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kelly-listen-recording-meta {
  display: flex;
  margin-top: 5px;
  align-items: center;
  gap: 6px;
  color: #71717c;
  font-family: var(--font-body);
  font-size: 11px;
  line-height: 1.4;
}

.kelly-listen-recording-meta svg {
  flex: 0 0 auto;
}

.kelly-listen-recording-dot {
  color: #696975;
}

@media (max-width: 900px) {
  .kelly-listen-page {
    padding: 32px 28px 44px;
  }

  .kelly-listen-grid {
    grid-template-columns: 1fr;
  }

  .kelly-listen-card {
    min-height: 400px;
  }
}

@media (max-width: 560px) {
  .kelly-listen-page {
    padding: 26px 18px 36px;
  }

  .kelly-listen-header h1 {
    font-size: 24px;
  }

  .kelly-listen-card {
    padding: 20px;
  }
}

/* ---------- REACT KELLY HOME ---------- */

.kelly-home-page {
  min-height: 100%;
  width: 100%;
  background: #0a0a0f;
}

.kelly-home-dashboard {
  width: 100%;
  min-height: 100vh;
  padding: 34px 38px 50px;
  background:
    radial-gradient(
      circle at 82% 0%,
      rgba(139, 92, 246, 0.07),
      transparent 30%
    ),
    #0a0a0f;
  color: #f8f7fb;
  box-sizing: border-box;
}

.kelly-home-welcome {
  margin-bottom: 28px;
}

.kelly-home-welcome h1 {
  margin: 0;
  color: #f8f7fb;
  font-family: Inter, system-ui, sans-serif;
  font-size: 32px;
  font-weight: 750;
  line-height: 1.15;
  letter-spacing: -0.04em;
}

.kelly-home-welcome h1 span {
  color: #a78bfa;
}

.kelly-home-welcome p {
  margin: 8px 0 0;
  color: #8d8d99;
  font-size: 14px;
}

.kelly-home-card {
  background: #101016;
  border: 1px solid #24242e;
  border-radius: 14px;
  box-shadow:
    0 12px 32px rgba(0, 0, 0, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.018);
  box-sizing: border-box;
}

.kelly-home-level-card {
  padding: 24px;
  margin-bottom: 16px;
}

.kelly-home-level-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.kelly-home-level-title {
  display: flex;
  align-items: center;
  gap: 14px;
}

.kelly-home-trophy {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: rgba(139, 92, 246, 0.12);
  font-size: 20px;
}

.kelly-home-section-label,
.kelly-home-stat-name {
  color: #767681;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.kelly-home-level-number {
  margin-top: 4px;
  color: #f5f4fa;
  font-size: 21px;
  font-weight: 700;
}

.kelly-home-level-next {
  text-align: right;
}

.kelly-home-level-next strong {
  display: block;
  color: #a78bfa;
  font-size: 14px;
}

.kelly-home-level-next span {
  display: block;
  margin-top: 3px;
  color: #70707b;
  font-size: 11px;
}

.kelly-home-xp-track {
  width: 100%;
  height: 7px;
  margin-top: 22px;
  overflow: hidden;
  border-radius: 99px;
  background: #1d1d26;
}

.kelly-home-xp-fill {
  width: 72%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #7c3aed, #a78bfa);
  box-shadow: 0 0 18px rgba(139, 92, 246, 0.32);
}

.kelly-home-level-bottom {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 11px;
  color: #6e6e79;
  font-size: 11px;
}

.kelly-home-level-bottom strong {
  color: #a78bfa;
}

.kelly-home-stat-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 16px;
}

.kelly-home-stat-card {
  position: relative;
  min-height: 130px;
  padding: 21px;
}

.kelly-home-stat-icon {
  position: absolute;
  top: 18px;
  right: 18px;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  background: rgba(139, 92, 246, 0.09);
  color: #a78bfa;
  font-size: 14px;
}

.kelly-home-stat-name {
  margin-bottom: 12px;
}

.kelly-home-stat-value {
  color: #f6f4fa;
  font-size: 25px;
  font-weight: 750;
  letter-spacing: -0.03em;
}

.kelly-home-stat-label {
  margin-top: 5px;
  color: #777782;
  font-size: 12px;
}

.kelly-home-two-col {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16px;
  margin-bottom: 16px;
}

.kelly-home-content-card {
  padding: 22px;
}

.kelly-home-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 17px;
}

.kelly-home-link {
  border: 1px solid rgba(139, 92, 246, 0.2);
  background: transparent;
  color: #a78bfa;
  border-radius: 9px;
  padding: 7px 11px;
  font: inherit;
  font-size: 11px;
  cursor: pointer;
}

.kelly-home-link:hover {
  background: rgba(139, 92, 246, 0.08);
}

.kelly-home-note-list,
.kelly-home-upcoming-list {
  display: flex;
  flex-direction: column;
}

.kelly-home-note-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 0;
  border: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.kelly-home-note-row:first-child {
  border-top: 0;
}

.kelly-home-note-row strong,
.kelly-home-upcoming-copy strong,
.kelly-home-friend-row strong,
.kelly-home-quiz-name {
  display: block;
  color: #f3f2f7;
  font-size: 13px;
  font-weight: 650;
}

.kelly-home-note-row span,
.kelly-home-upcoming-copy span,
.kelly-home-friend-row span {
  display: block;
  margin-top: 4px;
  color: #71717c;
  font-size: 11px;
}

.kelly-home-arrow {
  color: #666672 !important;
  font-size: 20px !important;
}

.kelly-home-upcoming-row {
  display: flex;
  align-items: stretch;
  gap: 12px;
  padding: 13px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.kelly-home-upcoming-row:first-child {
  border-top: 0;
}

.kelly-home-upcoming-bar {
  width: 3px;
  flex: 0 0 3px;
  border-radius: 99px;
}

.kelly-home-upcoming-bar.green {
  background: #35d07f;
}

.kelly-home-upcoming-bar.red {
  background: #ef596f;
}

.kelly-home-quiz-name {
  margin-top: 5px;
}

.kelly-home-quiz-summary {
  display: flex;
  gap: 55px;
  margin-top: 26px;
}

.kelly-home-quiz-summary > div {
  display: flex;
  flex-direction: column;
}

.kelly-home-quiz-summary strong {
  color: #f8f7fb;
  font-size: 27px;
  line-height: 1;
}

.kelly-home-quiz-summary span {
  margin-top: 7px;
  color: #6d6d78;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.kelly-home-score {
  color: #42d58a !important;
}

.kelly-home-quiz-xp {
  color: #a78bfa !important;
}

.kelly-home-friend-row {
  display: flex;
  align-items: center;
  gap: 13px;
  padding-top: 7px;
}

.kelly-home-friend-avatar {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed, #4c1d95);
  color: white;
  font-size: 13px;
  font-weight: 700;
}

.kelly-home-studying {
  color: #42d58a !important;
}

.kelly-home-quick-wrap {
  margin-top: 27px;
}

.kelly-home-quick-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-top: 13px;
}

.kelly-home-quick-action {
  min-height: 125px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px solid rgba(139, 92, 246, 0.12);
  border-radius: 14px;
  background: #101016;
  color: #f4f2f8;
  cursor: pointer;
  transition:
    transform 0.16s ease,
    border-color 0.16s ease,
    background 0.16s ease;
}

.kelly-home-quick-action:hover {
  transform: translateY(-2px);
  border-color: rgba(139, 92, 246, 0.32);
  background: #13131b;
}

.kelly-home-quick-icon {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: rgba(139, 92, 246, 0.1);
  color: #a78bfa;
  font-size: 18px;
}

.kelly-home-quick-action strong {
  font-size: 12px;
  font-weight: 650;
}

@media (max-width: 1000px) {
  .kelly-home-stat-row {
    grid-template-columns: repeat(2, 1fr);
  }

  .kelly-home-quick-row {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .kelly-home-dashboard {
    padding: 28px 22px 40px;
  }

  .kelly-home-two-col {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .kelly-home-dashboard {
    padding: 24px 18px 34px;
  }

  .kelly-home-welcome h1 {
    font-size: 28px;
  }

  .kelly-home-level-top {
    flex-direction: column;
  }

  .kelly-home-level-next {
    text-align: left;
  }

  .kelly-home-stat-row,
  .kelly-home-quick-row {
    grid-template-columns: 1fr;
  }
}
/* ---------- REACT NOTES ---------- */

.kelly-notes-page-react {
  display: grid;
  grid-template-columns: 360px minmax(0, 1fr);
  width: 100%;
  height: 100%;
  min-height: 0;
  background: #0a0a0f;
  color: #f5f3fa;
}

.kelly-notes-page-react .kelly-notes-list {
  width: 360px;
  min-width: 360px;
  height: 100%;
  min-height: 0;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 28px 22px;
  background: #0d0d13;
  border-right: 1px solid rgba(255,255,255,.07);
}

.kelly-notes-page-react .kelly-notes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 20px;
}

.kelly-notes-page-react .kelly-notes-header h1 {
  margin: 0;
  color: #f8f7fb;
  font-size: 24px;
  font-weight: 750;
  letter-spacing: -.035em;
}

.kelly-notes-page-react .kelly-notes-new,
.kelly-notes-page-react .kelly-create-note {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 0;
  border-radius: 9px;
  background: #7c5cff;
  color: #fff;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.kelly-notes-page-react .kelly-notes-new {
  padding: 9px 13px;
}

.kelly-notes-page-react .kelly-notes-new span {
  font-size: 16px;
  line-height: 1;
}

.kelly-notes-page-react .kelly-notes-search {
  position: relative;
  margin-bottom: 14px;
}

.kelly-notes-page-react .kelly-notes-search-icon {
  position: absolute;
  left: 13px;
  top: 50%;
  transform: translateY(-50%);
  color: #686875;
  font-size: 18px;
  pointer-events: none;
}

.kelly-notes-page-react .kelly-notes-search input {
  width: 100%;
  height: 42px;
  box-sizing: border-box;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 10px;
  outline: none;
  padding: 0 13px 0 38px;
  background: #15151d;
  color: #f5f3fa;
  font-size: 12px;
}

.kelly-notes-page-react .kelly-notes-search input::placeholder {
  color: #676772;
}

.kelly-notes-page-react .kelly-notes-search input:focus {
  border-color: rgba(124,92,255,.6);
  box-shadow: 0 0 0 3px rgba(124,92,255,.08);
}

.kelly-notes-page-react .kelly-note-items {
  display: flex;
  flex-direction: column;
}

.kelly-notes-page-react .kelly-note-item {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-sizing: border-box;
  padding: 17px 4px;
  border: 0;
  border-top: 1px solid rgba(255,255,255,.055);
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.kelly-notes-page-react .kelly-note-item:hover {
  background: #15151d;
}

.kelly-notes-page-react .kelly-note-item.active {
  background: rgba(124,92,255,.10);
  border-radius: 9px;
  padding-left: 10px;
  padding-right: 10px;
}

.kelly-notes-page-react .kelly-note-item-copy {
  min-width: 0;
}

.kelly-notes-page-react .kelly-note-item-copy strong {
  display: block;
  overflow: hidden;
  color: #f3f1f8;
  font-size: 13px;
  font-weight: 650;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kelly-notes-page-react .kelly-note-item-copy span {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
  font-size: 10.5px;
}

.kelly-notes-page-react .kelly-note-item-copy b {
  font-weight: 650;
}

.kelly-notes-page-react .kelly-note-item-copy em {
  color: #696975;
  font-style: normal;
}

.kelly-notes-page-react .note-subject-green {
  color: #42d58a;
}

.kelly-notes-page-react .note-subject-blue {
  color: #69a8ff;
}

.kelly-notes-page-react .note-subject-orange {
  color: #f6a04d;
}

.kelly-notes-page-react .kelly-note-chevron {
  flex: 0 0 auto;
  color: #5e5e69;
  font-size: 23px;
}

.kelly-notes-page-react .kelly-note-reader {
  position: relative;
  min-width: 0;
  min-height: 0;
  height: 100%;
  overflow-y: auto;
  background:
    radial-gradient(
      circle at 75% 8%,
      rgba(124,92,255,.055),
      transparent 34%
    ),
    #0a0a0f;
}

.kelly-notes-page-react .kelly-notes-empty {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
  text-align: center;
}

.kelly-notes-page-react .kelly-notes-empty-icon {
  position: relative;
  width: 70px;
  height: 84px;
  margin-bottom: 20px;
  border: 2px solid #454550;
  border-radius: 8px;
  opacity: .75;
}

.kelly-notes-page-react .kelly-notes-empty-icon::before,
.kelly-notes-page-react .kelly-notes-empty-icon::after {
  content: "";
  position: absolute;
  left: 15px;
  right: 15px;
  height: 2px;
  border-radius: 2px;
  background: #454550;
}

.kelly-notes-page-react .kelly-notes-empty-icon::before {
  top: 29px;
}

.kelly-notes-page-react .kelly-notes-empty-icon::after {
  top: 42px;
}

.kelly-notes-page-react .kelly-notes-empty-icon span {
  position: absolute;
  left: 15px;
  right: 28px;
  top: 55px;
  height: 2px;
  border-radius: 2px;
  background: #454550;
}

.kelly-notes-page-react .kelly-note-detail {
  min-width: 0;
  width: 100%;
  height: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 34px 42px 60px;
  margin: 0;
  background: #0a0a0f;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  overflow-y: auto;
}

.kelly-notes-page-react .kelly-note-detail-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 18px;
}

.kelly-notes-page-react .kelly-note-detail-top h1 {
  margin: 0;
  color: #f8f7fb;
  font-size: 34px;
  line-height: 1.12;
  font-weight: 760;
  letter-spacing: -.045em;
}

.kelly-notes-page-react .kelly-detail-meta {
  margin-top: 10px;
  color: #858490;
  font-size: 12px;
}

.kelly-notes-page-react .meta-subject-green {
  color: #42d58a;
  font-weight: 650;
}

.kelly-notes-page-react .meta-subject-blue {
  color: #69a8ff;
  font-weight: 650;
}

.kelly-notes-page-react .meta-subject-orange {
  color: #f6a04d;
  font-weight: 650;
}

.kelly-notes-page-react .kelly-detail-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 8px;
}

.kelly-notes-page-react .kelly-note-action {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 8px;
  padding: 8px 13px;
  background: #15151d;
  color: #d7d5df;
  font: inherit;
  font-size: 11px;
  font-weight: 650;
  cursor: pointer;
}

.kelly-notes-page-react .kelly-note-action:hover {
  border-color: rgba(124,92,255,.45);
  color: #fff;
}

.kelly-notes-page-react .kelly-note-delete {
  color: #ff8585;
  background: rgba(239,68,68,.10);
  border-color: rgba(239,68,68,.28);
}

.kelly-notes-page-react .kelly-note-delete:hover {
  color: #ff9d9d;
  background: rgba(239,68,68,.16);
  border-color: rgba(239,68,68,.28);
}

.kelly-notes-page-react .kelly-note-section {
  margin-top: 34px;
}

.kelly-notes-page-react .kelly-note-section:first-child {
  margin-top: 0;
}

.kelly-notes-page-react .kelly-note-section-label {
  margin-bottom: 12px;
  color: #777581;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .16em;
}

.kelly-notes-page-react .kelly-note-summary {
  color: #c0bec8;
  font-size: 14px;
  line-height: 1.8;
}

.kelly-notes-page-react .kelly-concept-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.kelly-notes-page-react .kelly-concept-chip {
  display: inline-flex;
  align-items: center;
  padding: 7px 11px;
  border: 1px solid rgba(124,92,255,.16);
  border-radius: 999px;
  background: rgba(124,92,255,.11);
  color: #c5baff;
  font-size: 11px;
  font-weight: 650;
}

.kelly-notes-page-react .kelly-key-points {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.kelly-notes-page-react .kelly-key-points li {
  position: relative;
  padding-left: 18px;
  color: #bbb9c4;
  font-size: 13px;
  line-height: 1.7;
}

.kelly-notes-page-react .kelly-key-points li::before {
  content: "";
  position: absolute;
  left: 2px;
  top: .7em;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #7c5cff;
}

.kelly-notes-page-react .kelly-definitions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.kelly-notes-page-react .kelly-definition-card {
  padding: 14px 16px;
  border: 1px solid rgba(255,255,255,.065);
  border-radius: 10px;
  background: #111118;
}

.kelly-notes-page-react .kelly-definition-term {
  margin-bottom: 5px;
  color: #aa96ff;
  font-size: 12px;
  font-weight: 750;
}

.kelly-notes-page-react .kelly-definition-text {
  color: #b5b3be;
  font-size: 12px;
  line-height: 1.65;
}

.kelly-notes-page-react .kelly-takeaways {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.kelly-notes-page-react .kelly-takeaway {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: #bbb9c4;
  font-size: 13px;
  line-height: 1.65;
}

.kelly-notes-page-react .kelly-takeaway-check {
  flex: 0 0 auto;
  width: 18px;
  height: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(66,213,138,.12);
  color: #42d58a;
  font-size: 11px;
  font-weight: 800;
}

@media (max-width: 900px) {
  .kelly-notes-page-react {
    grid-template-columns: 1fr;
    height: auto;
    min-height: 100vh;
  }

  .kelly-notes-page-react .kelly-notes-list {
    width: 100%;
    min-width: 0;
    max-width: none;
    height: auto;
    min-height: 0;
    max-height: 42vh;
    border-right: 0;
    border-bottom: 1px solid #20202a;
  }

  .kelly-notes-page-react .kelly-note-reader {
    height: auto;
    min-height: 58vh;
    overflow: visible;
  }

  .kelly-notes-page-react .kelly-note-detail {
    height: auto;
    min-height: 58vh;
    padding: 28px 22px 48px;
    overflow: visible;
  }
}

@media (max-width: 700px) {
  .kelly-notes-page-react .kelly-note-detail-top {
    flex-direction: column;
  }
}
